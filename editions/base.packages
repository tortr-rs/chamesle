# packages in every edition, from the chamesle repo

# core system
base-files bash coreutils findutils diffutils grep sed gawk which file less
gzip bzip2 xz zstd tar unzip
util-linux shadow procps-ng psmisc kmod eudev dbus elogind polkit dinit busybox apk-tools plymouth
iproute2 iputils NetworkManager openssh curl wget ca-certificates rsync
sudo nano glibc-locales tzdata man-db

# kernel (the LTS series, pinned), firmware, microcode
linux6.18 linux6.18-headers linux-firmware intel-ucode

# disks, filesystems, boot
grub grub-x86_64-efi grub-i386-efi efibootmgr os-prober
e2fsprogs dosfstools ntfs-3g exfatprogs btrfs-progs xfsprogs cryptsetup lvm2 gptfdisk parted

# graphics
xorg-minimal xorg-input-drivers xorg-video-drivers xorg-fonts
mesa-dri mesa-vulkan-intel mesa-vulkan-radeon vulkan-loader mesa-vaapi intel-video-accel

# sound, bluetooth, printing
pipewire wireplumber alsa-pipewire alsa-utils bluez cups cups-filters
# sound on most newer intel laptops needs these
sof-firmware alsa-ucm-conf

# flatpak, firefox, fonts
flatpak xdg-desktop-portal xdg-user-dirs firefox
noto-fonts-ttf noto-fonts-emoji dejavu-fonts-ttf

# toolchain for get
gcc make pkg-config cmake meson ninja perl python3 autoconf automake libtool patch bison flex git

# the installer and dracut for installed systems
python3-gobject gtk+3 libtimezonemap libwebkit2gtk41 gparted parted gptfdisk iso-codes
python3-Pillow python3-distro python3-cairo python3-requests python3-parted circle-flags-svg
setxkbmap ckbcomp xkeyboard-config lvm2 dosfstools dracut xrandr

# .deb and .rpm packages (pkgimport)
bsdtar rpm zenity

# the store, update notifier and driver manager
chamesle-store chamesle-updater chamesle-drivers chamesle-base
