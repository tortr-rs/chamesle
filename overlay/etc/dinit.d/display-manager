# The graphical login (LightDM). On the live system it logs the live user in by itself.
type = process
command = /usr/bin/lightdm
depends-on = dbus
depends-on = elogind
waits-for = polkitd
waits-for = plymouth-quit
waits-for = udev-trigger
waits-for = network
restart = true
smooth-recovery = true
logfile = /var/log/lightdm-dinit.log
