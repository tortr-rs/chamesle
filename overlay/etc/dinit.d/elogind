# Login and seat management (the logind API without systemd): user sessions, /run/user/UID, suspend and
# shutdown from the desktop, device access for the logged-in user.
type = process
command = /usr/libexec/elogind/elogind
depends-on = dbus
depends-on = udev-trigger
restart = true
smooth-recovery = true
logfile = /var/log/elogind.log
