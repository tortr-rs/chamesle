#!/usr/bin/python3
# install a .deb or .rpm: turn it into an apk that depends on the libs it links to
#   sudo pkgimport install foo.deb
#   pkgimport convert foo.rpm -o DIR
# dpkg/rpm scripts are not run
import os, re, shutil, struct, subprocess, sys, tempfile


def die(msg):
    sys.exit(f'pkgimport: {msg}')


def run(*cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


def apkver(v, rel='0'):
    # 2:1.2.3~beta1-0ubuntu4 -> 1.2.3_beta1-r0, anything odd falls back to its leading numbers
    v = v.split(':', 1)[-1].lower()
    up, _, deb = v.rpartition('-') if '-' in v else (v, '', rel)
    m = re.match(r'\d+', deb)
    rev = m.group(0) if m else rel
    up = up.replace('~', '_').replace('+', '_p')
    up = re.sub(r'\.?(alpha|beta|pre|rc)(\d*)', r'_\1\2', up)
    if not re.fullmatch(r'\d+(\.\d+)*[a-z]?(_(alpha|beta|pre|rc|p)\d*)*', up):
        m = re.match(r'\d+(\.\d+)*', up)
        up = (m.group(0) if m else '0') + '_p0'
    return f'{up}-r{int(rev)}'


def needed(path):
    # DT_NEEDED entries of a 64-bit little endian ELF file, [] for anything else
    try:
        with open(path, 'rb') as f:
            data = f.read()
    except OSError:
        return []
    if data[:4] != b'\x7fELF' or data[4] != 2 or data[5] != 1:
        return []
    shoff, = struct.unpack_from('<Q', data, 0x28)
    shentsize, shnum = struct.unpack_from('<HH', data, 0x3a)
    secs = [struct.unpack_from('<IIQQQQIIQQ', data, shoff + i * shentsize) for i in range(shnum)]
    out = []
    for name, typ, flags, addr, off, size, link, info, align, entsize in secs:
        if typ != 6:  # SHT_DYNAMIC
            continue
        stroff = secs[link][4]
        for i in range(0, size, 16):
            tag, val = struct.unpack_from('<qQ', data, off + i)
            if tag == 0:
                break
            if tag == 1:  # DT_NEEDED
                end = data.index(b'\0', stroff + val)
                out.append(data[stroff + val:end].decode())
    return out


def unpack(pkg, root):
    meta = {}
    if pkg.endswith('.deb'):
        ctl = tempfile.mkdtemp()
        run('bsdtar', '-xf', pkg, '-C', ctl)
        data = [f for f in os.listdir(ctl) if f.startswith('data.tar')]
        control = [f for f in os.listdir(ctl) if f.startswith('control.tar')]
        if not data or not control:
            die(f'{pkg}: not a debian package')
        run('bsdtar', '-xf', os.path.join(ctl, data[0]), '-C', root)
        info = os.path.join(ctl, 'info')
        os.mkdir(info)
        run('bsdtar', '-xf', os.path.join(ctl, control[0]), '-C', info)
        text = open(os.path.join(info, 'control'), errors='replace').read()
        shutil.rmtree(ctl)
        key = None
        for line in text.splitlines():
            if line[:1] in (' ', '\t') and key:
                continue
            k, _, v = line.partition(':')
            key = k.strip().lower()
            meta[key] = v.strip()
        meta = {'name': meta.get('package'), 'version': meta.get('version', '0'),
                'description': meta.get('description', ''), 'url': meta.get('homepage', ''),
                'license': 'unknown', 'arch': meta.get('architecture', 'amd64')}
    elif pkg.endswith('.rpm'):
        q = '%{NAME}\n%{VERSION}\n%{RELEASE}\n%{SUMMARY}\n%{URL}\n%{LICENSE}\n%{ARCH}\n'
        r = subprocess.run(['rpm', '-qp', '--nosignature', '--qf', q, pkg], capture_output=True, text=True)
        if r.returncode == 0:
            name, ver, rel, summary, url, lic, arch = (r.stdout.split('\n') + [''] * 7)[:7]
        else:
            # no rpm tool: go by the file name, name-version-release.arch.rpm
            m = re.match(r'^(.+)-([^-]+)-([^-]+)\.([^.]+)\.rpm$', os.path.basename(pkg))
            if not m:
                die(f'{pkg}: can\'t tell the name and version')
            name, ver, rel, arch = m.groups()
            summary, url, lic = name, '', 'unknown'
        run('bsdtar', '-xf', pkg, '-C', root)
        meta = {'name': name, 'version': f'{ver}-{re.match(r"[0-9]*", rel).group(0) or 0}',
                'description': summary, 'url': url if url != '(none)' else '', 'license': lic, 'arch': arch}
    else:
        die(f'{pkg}: only .deb and .rpm')
    if meta['arch'] not in ('amd64', 'x86_64', 'all', 'noarch'):
        die(f'{pkg}: built for {meta["arch"]}, this computer is x86_64')
    if not meta['name']:
        die(f'{pkg}: no package name')
    return meta


def merge(src, dst):
    # move everything in src into dst, keeping what's already there
    os.makedirs(dst, exist_ok=True)
    for f in os.listdir(src):
        s, d = os.path.join(src, f), os.path.join(dst, f)
        if os.path.isdir(s) and not os.path.islink(s) and os.path.isdir(d):
            merge(s, d)
        elif not os.path.lexists(d):
            os.rename(s, d)
    shutil.rmtree(src, ignore_errors=True)


def relayout(root):
    # this system: everything under /usr, one lib dir, one bin dir
    for top in ('bin', 'sbin', 'lib', 'lib64'):
        p = os.path.join(root, top)
        if os.path.isdir(p) and not os.path.islink(p):
            merge(p, os.path.join(root, 'usr', top))
    for d in ('usr/lib/x86_64-linux-gnu', 'usr/lib64'):
        p = os.path.join(root, d)
        if os.path.isdir(p) and not os.path.islink(p):
            merge(p, os.path.join(root, 'usr/lib'))
    p = os.path.join(root, 'usr/sbin')
    if os.path.isdir(p) and not os.path.islink(p):
        merge(p, os.path.join(root, 'usr/bin'))
    # leftovers that would clash with the system's own symlinks
    for d in ('bin', 'sbin', 'lib', 'lib64', 'usr/sbin', 'usr/lib64'):
        p = os.path.join(root, d)
        if os.path.islink(p):
            os.remove(p)


def convert(pkg, outdir):
    tmp = tempfile.mkdtemp(prefix='pkgimport.')
    root = os.path.join(tmp, 'root')
    os.mkdir(root)
    meta = unpack(pkg, root)
    relayout(root)

    have, wants = set(), set()
    for d, _, files in os.walk(root):
        for f in files:
            p = os.path.join(d, f)
            if '.so' in f:
                have.add(f)
            if not os.path.islink(p):
                wants.update(needed(p))
    deps = sorted('so:' + l for l in wants - have)

    name = re.sub(r'[^a-z0-9._+-]', '-', meta['name'].lower())
    ver = apkver(meta['version'])
    out = os.path.join(outdir, f'{name}-{ver}.apk')
    post = os.path.join(tmp, 'post-install')
    with open(post, 'w') as f:
        f.write('#!/bin/sh\n'
                'ldconfig 2>/dev/null\n'
                'update-desktop-database -q 2>/dev/null\n'
                'gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null\n'
                'glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null\n'
                'exit 0\n')
    os.chmod(post, 0o755)
    args = ['apk', 'mkpkg', '--files', root, '--output', out,
            '--info', f'name:{name}', '--info', f'version:{ver}', '--info', 'arch:x86_64',
            '--info', f'description:{meta["description"] or name}', '--info', f'license:{meta["license"] or "unknown"}',
            '--info', f'origin:{os.path.basename(pkg)}',
            '--script', f'post-install:{post}', '--script', f'post-upgrade:{post}']
    if meta['url']:
        args += ['--info', f'url:{meta["url"]}']
    if deps:
        args += ['--info', 'depends:' + ' '.join(deps)]
    run(*args)
    shutil.rmtree(tmp, ignore_errors=True)
    return name, out


def main():
    a = sys.argv[1:]
    if len(a) < 2 or a[0] not in ('install', 'convert'):
        sys.exit('usage: sudo pkgimport install FILE.deb|FILE.rpm ...\n'
                 '       pkgimport convert FILE.deb|FILE.rpm ... [-o DIR]')
    cmd, files = a[0], a[1:]
    outdir = None
    if '-o' in files:
        i = files.index('-o')
        outdir = files[i + 1]
        del files[i:i + 2]
    if cmd == 'install' and os.geteuid() != 0:
        die('installing needs root: sudo pkgimport install ...')
    work = outdir or tempfile.mkdtemp(prefix='pkgimport.')
    built = []
    for f in files:
        if not os.path.isfile(f):
            die(f'{f}: no such file')
        name, apk = convert(os.path.abspath(f), work)
        print(f'{f} -> {name} ({os.path.basename(apk)})')
        built.append(apk)
    if cmd == 'install':
        r = subprocess.run(['apk', 'add', '--allow-untrusted'] + built)
        if r.returncode:
            print('pkgimport: "so:... (no such package)" means it wants a library we don\'t have', file=sys.stderr)
        if not outdir:
            shutil.rmtree(work, ignore_errors=True)
        sys.exit(r.returncode)


main()
