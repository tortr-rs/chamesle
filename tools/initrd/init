#!/bin/busybox sh
# chamesle initramfs. no root= means live: find the stick, overlay a tmpfs on the squashfs
# options: root= rootfstype= rootflags= init= chamesle.iso=PATH chamesle.toram=1 chamesle.label=NAME
#          chamesle.wait=SECS chamesle.debug=1 (shell before switch_root) chamesle.shell=1 (shell first)
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

/bin/busybox mkdir -p /proc /sys /dev /mnt /newroot /overlay
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox --install -s /bin 2>/dev/null
exec </dev/console >/dev/console 2>&1

log() { echo "[live] $*"; }
SPLASH=0
emergency() {
    # something's wrong: the blue screen says what, any key goes on to the shell. not for the debug shells
    if [ "$SPLASH" = 1 ] && [ "$DEBUG" = 0 ] && [ "$SHELL_FIRST" = 0 ]; then
        plymouth display-message --text=chamesle-error
        plymouth display-message --text="$*"
        plymouth watch-keystroke >/dev/null 2>&1
    fi
    [ "$SPLASH" = 1 ] && { plymouth quit; SPLASH=0; }
    echo "[live] $*"
    echo "[live] starting a shell; leave it with 'exit' to try again"
    setsid cttyhack sh
}
# LUKS1 and LUKS2 both start with "LUKS\xba\xbe"
is_luks() {
    [ "$(dd if="$1" bs=6 count=1 2>/dev/null | od -An -tx1 | tr -d ' \t\n\r')" = "4c554b53babe" ]
}

LABEL=CHAMESLE ISO_HINT= DEBUG=0 SHELL_FIRST=0 TORAM=0 WAIT=60 INIT=/usr/bin/dinit
ROOT= ROOTFSTYPE= ROOTFLAGS= QUIET=0
for a in $(cat /proc/cmdline); do
    case "$a" in
        chamesle.iso=*)   ISO_HINT=${a#chamesle.iso=} ;;
        chamesle.debug=1) DEBUG=1 ;;
        chamesle.shell=1) SHELL_FIRST=1 ;;
        chamesle.toram=1) TORAM=1 ;;
        chamesle.label=*) LABEL=${a#chamesle.label=} ;;
        chamesle.wait=*)  WAIT=${a#chamesle.wait=} ;;
        init=/*)             INIT=${a#init=} ;;
        root=*)              ROOT=${a#root=} ;;
        rootfstype=*)        ROOTFSTYPE=${a#rootfstype=} ;;
        rootflags=*)         ROOTFLAGS=${a#rootflags=} ;;
        quiet)               QUIET=1 ;;
    esac
done

# storage and filesystem drivers
if [ -d "/lib/modules/$(uname -r)" ]; then
    for m in usb_storage uas xhci_pci ehci_pci ohci_pci uhci_hcd ahci nvme virtio_pci virtio_blk virtio_scsi \
             libata ata_piix ata_generic pata_acpi scsi_mod mmc_block sd_mod sr_mod isofs udf vfat exfat ext4 xfs btrfs f2fs \
             squashfs loop overlay dm_mod dm_crypt; do
        modprobe "$m" 2>/dev/null || FAILED_MODS="${FAILED_MODS:-} $m"
    done
    [ -n "${FAILED_MODS:-}" ] && log "modules not loaded (built in or not shipped):$FAILED_MODS"
    mdev -s 2>/dev/null
else
    log "no kernel modules in the initramfs; relying on built-in drivers"
fi

# drivers for whatever hardware is there. again while waiting, new controllers bring new devices
load_hw_modules() {
    [ -d "/lib/modules/$(uname -r)" ] || return 0
    for f in $(find /sys/devices -name modalias 2>/dev/null); do
        read -r alias < "$f" 2>/dev/null || continue
        [ -n "$alias" ] && modprobe -q "$alias" 2>/dev/null
    done
    mdev -s 2>/dev/null
    return 0
}
load_hw_modules

# boot splash
if grep -qw splash /proc/cmdline && [ -x /usr/bin/plymouthd ]; then
    mkdir -p /run/plymouth /run/udev /dev/pts
    mount -t devpts devpts /dev/pts 2>/dev/null
    # plymouth only finds the framebuffer through udev
    if [ -x /usr/bin/udevd ]; then
        udevd --daemon --resolve-names=never 2>/dev/null
        udevadm trigger --action=add --subsystem-match=graphics --subsystem-match=drm
        udevadm settle --timeout=5
    fi
    plymouthd --mode=boot --attach-to-session --pid-file=/run/plymouth/pid && plymouth show-splash && SPLASH=1
fi

[ "$SHELL_FIRST" = 1 ] && emergency "chamesle.shell=1"

# with several chamesle isos on one ventoy stick, take the one matching our build id (not after 15s)
STRICT=1
[ -s /build-id ] || STRICT=0
has_root() {
    [ -f "$1/live/rootfs.squashfs" ] || return 1
    [ "$STRICT" = 0 ] || [ "$(cat "$1/live/build-id" 2>/dev/null)" = "$(cat /build-id)" ]
}

# every block device, and iso files on them (ventoy). sets MEDIUM
scan_once() {
    n=0
    ldev=$(findfs "LABEL=$LABEL" 2>/dev/null) && [ -b "$ldev" ] && mkdir -p /mnt/label &&
        mount -o ro "$ldev" /mnt/label 2>/dev/null && {
        if has_root /mnt/label; then MEDIUM=/mnt/label; return 0; fi
        umount /mnt/label 2>/dev/null
    }
    for dev in /dev/sr[0-9]* /dev/sd[a-z] /dev/sd[a-z][0-9]* /dev/vd[a-z] /dev/vd[a-z][0-9]* \
               /dev/nvme[0-9]n[0-9] /dev/nvme[0-9]n[0-9]p[0-9]* /dev/mmcblk[0-9] /dev/mmcblk[0-9]p[0-9]* \
               /dev/mapper/*; do
        [ -b "$dev" ] || continue
        n=$((n + 1)); mp=/mnt/d$n
        mkdir -p "$mp"
        mount -o ro "$dev" "$mp" 2>/dev/null || continue
        if has_root "$mp"; then MEDIUM=$mp; return 0; fi
        k=0
        check_isos() {
            for iso in "$@"; do
                [ -f "$iso" ] || continue
                k=$((k + 1)); imp=/mnt/i$n-$k
                mkdir -p "$imp"
                if mount -o loop,ro "$iso" "$imp" 2>/dev/null; then
                    if has_root "$imp"; then MEDIUM=$imp; return 0; fi
                    umount "$imp" 2>/dev/null
                fi
            done
            return 1
        }
        set --
        [ -n "${ISO_HINT:-}" ] && [ -f "$mp$ISO_HINT" ] && set -- "$@" "$mp$ISO_HINT"
        for f in "$mp"/[Cc]hamesle*.iso "$mp"/*/[Cc]hamesle*.iso "$mp"/*.iso "$mp"/*/*.iso; do
            [ -f "$f" ] && set -- "$@" "$f"
        done
        check_isos "$@"
        [ -n "${MEDIUM:-}" ] && return 0
        umount "$mp" 2>/dev/null
    done
    return 1
}

# findfs knows UUID= and LABEL=; a /dev path is used as it is
find_dev() {
    case "$1" in
        /dev/*) [ -b "$1" ] && echo "$1" ;;
        *)      findfs "$1" 2>/dev/null ;;
    esac
}

if [ -n "$ROOT" ]; then
    i=0
    until DEV=$(find_dev "$ROOT") && [ -n "$DEV" ]; do
        i=$((i + 1))
        if [ "$i" -ge "$WAIT" ]; then
            emergency "could not find the root partition ($ROOT)"
            i=0
        fi
        [ "$i" = 1 ] && log "waiting for the root partition ($ROOT)..."
        sleep 1
        load_hw_modules
    done
    if is_luks "$DEV"; then
        log "encrypted root partition: enter the passphrase to unlock it"
        until [ -e /dev/mapper/root ]; do
            if [ "$SPLASH" = 1 ]; then
                plymouth ask-for-password --prompt="Passphrase" --command="cryptsetup open --key-file=- $DEV root" ||
                    plymouth display-message --text="Wrong passphrase, try again"
            else
                cryptsetup open "$DEV" root || log "wrong passphrase, try again"
            fi
        done
        DEV=/dev/mapper/root
    fi
    until mount ${ROOTFSTYPE:+-t "$ROOTFSTYPE"} -o "rw${ROOTFLAGS:+,$ROOTFLAGS}" "$DEV" /newroot; do
        emergency "could not mount $DEV on / (rootfstype=${ROOTFSTYPE:-auto} rootflags=${ROOTFLAGS:-none})"
    done
else
    while :; do
        i=0
        until scan_once; do
            i=$((i + 1))
            [ "$i" -ge 15 ] && STRICT=0
            if [ "$i" -ge "$WAIT" ]; then break; fi
            [ "$i" = 1 ] && log "waiting for the live medium..."
            sleep 1
            load_hw_modules
        done
        [ -n "${MEDIUM:-}" ] && break
        log "filesystems: $(tr -d '\t' </proc/filesystems | grep -E 'iso9660|squashfs|overlay|vfat|ext4' | tr '\n' ' ')"
        log "kernel modules loaded: $(cut -d' ' -f1 /proc/modules 2>/dev/null | tr '\n' ' ')"
        log "block devices: $(cat /proc/partitions 2>/dev/null | awk 'NR>2 {print $4}' | tr '\n' ' ')"
        emergency "could not find the live medium (a device with /live/rootfs.squashfs)"
    done
    log "medium found: $MEDIUM"

    SQ=$MEDIUM/live/rootfs.squashfs
    if [ "$TORAM" = 1 ]; then
        log "copying the system into RAM (this takes a moment)..."
        avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
        need=$(du -k "$SQ" | awk '{print $1}')
        if [ "${avail:-0}" -lt "$((need * 2 + 50000))" ]; then
            emergency "not enough RAM for toram (need ${need}KB plus the running system, have ${avail:-0}KB)"
        fi
        cp "$SQ" /rootfs.squashfs && SQ=/rootfs.squashfs
    fi

    mkdir -p /mnt/squash
    until mount -t squashfs -o loop,ro "$SQ" /mnt/squash; do
        emergency "could not mount $SQ"
    done
    mount -t tmpfs -o size=75% tmpfs /overlay
    mkdir -p /overlay/upper /overlay/work
    until mount -t overlay overlay -o lowerdir=/mnt/squash,upperdir=/overlay/upper,workdir=/overlay/work /newroot; do
        emergency "could not create the overlay root"
    done
    mkdir -p /newroot/live-medium
    mount --move "$MEDIUM" /newroot/live-medium
fi

mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
# dinit wants /run for its socket before any service runs
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /newroot/run
if [ -n "${MEDIUM:-}" ]; then
    : > /newroot/run/chamesle-live
    # what the installer copies
    mkdir -p /newroot/run/chamesle/rootfs
    mount --bind /mnt/squash /newroot/run/chamesle/rootfs
fi
[ "$DEBUG" = 1 ] && emergency "chamesle.debug=1: about to switch root"
[ -x "/newroot$INIT" ] || emergency "$INIT not found in the system image"
INIT_ARGS=
# dinit starts the blue screen (its recovery service) on its own if the system can't finish starting. its log is
# how the blue screen knows what failed
[ "$INIT" = /usr/bin/dinit ] && [ -x /newroot/usr/lib/chamesle/blue-screen ] &&
    INIT_ARGS="--auto-recovery --log-file /run/dinit.log"
[ "$QUIET" = 1 ] && [ "$INIT" = /usr/bin/dinit ] && [ "$DEBUG" = 0 ] && INIT_ARGS="$INIT_ARGS --quiet"
[ "$SPLASH" = 1 ] && plymouth update-root-fs --new-root-dir=/newroot
udevadm control --exit 2>/dev/null
exec switch_root /newroot "$INIT" $INIT_ARGS
