name=chamesle-base
version=0.2.1
rel=3
desc="Chamesle system setup: sound, kernel modules at boot, a few small touches"
url=https://chamesle.org
license=GPL-3.0-or-later
source=
makedeps=""
# ncurses-term: the terminal descriptions htop, nano and friends need (xterm-256color, tmux, kitty...)
# pipewire: started at login by the links in files/, with wireplumber and the pulseaudio server
depends="kmod sudo fastfetch ncurses-term pipewire wireplumber"

build() {
    cp -a . "$pkgdir/"
}
