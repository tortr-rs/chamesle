# the chamesle look for cinnamon, same as the other editions
[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/backgrounds/chamesle/matterhorn.jpg'
picture-options='zoom'

[org.cinnamon.desktop.interface]
gtk-theme='Chamesle-Glass'
icon-theme='Chamesle-Glass'
cursor-theme='Adwaita'
font-name='Inter 10'

[org.gnome.desktop.interface]
# gnome-terminal and other gtk apps read the fonts from here
font-name='Inter 10'
monospace-font-name='Noto Sans Mono 10'
document-font-name='Inter 10'

[org.cinnamon.desktop.wm.preferences]
theme='Chamesle-Glass'
titlebar-font='Inter Semi-Bold 10'

[org.cinnamon.theme]
name='Chamesle-Glass'

[org.cinnamon.settings-daemon.plugins.xsettings]
antialiasing='grayscale'
hinting='slight'

[org.cinnamon]
panels-height=['1:44']

[org.nemo.desktop]
home-icon-visible=true
trash-icon-visible=true
computer-icon-visible=false
