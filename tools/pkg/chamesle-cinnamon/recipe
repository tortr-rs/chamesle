# gnome-keyring: cinnamon looks for saved wi-fi passwords there before asking for one, and without it the
# lookup fails, no password box shows up and the network says the password is wrong
depends="onestepback chamesle-gray chamesle-glass-icons chamesle-artwork gnome-keyring"

build() {
    cp -a . "$pkgdir/"
}
