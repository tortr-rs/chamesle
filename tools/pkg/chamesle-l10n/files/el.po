#: overlay/usr/lib/jiggity/account.py:56
msgid "A username is lowercase letters and numbers, starting with a letter."
msgstr "Ένα όνομα χρήστη έχει πεζά γράμματα και αριθμούς και ξεκινά με γράμμα."

#: overlay/usr/lib/jiggity/account.py:58
msgid "That username is taken by the system. Pick another one."
msgstr "Αυτό το όνομα χρήστη το χρησιμοποιεί ήδη το σύστημα. Διαλέξτε άλλο."

#: overlay/usr/lib/jiggity/account.py:97
msgid "A computer name is lowercase letters, numbers and dashes."
msgstr "Ένα όνομα υπολογιστή έχει πεζά γράμματα, αριθμούς και παύλες."

#: overlay/usr/lib/jiggity/firstboot.py:32
msgid "Let's start with your time zone. Is this the right one?"
msgstr "Ας ξεκινήσουμε με τη ζώνη ώρας σας. Είναι αυτή η σωστή;"

#: overlay/usr/lib/jiggity/firstboot.py:33
msgid "It sets your clock. Type a city to find yours."
msgstr "Ρυθμίζει το ρολόι σας. Πληκτρολογήστε μια πόλη για να βρείτε τη δική σας."

#: overlay/usr/lib/jiggity/firstboot.py:50
msgid "Yes"
msgstr "Ναι"

#: overlay/usr/lib/jiggity/firstboot.py:59
msgid "Let's connect you to a network"
msgstr "Ας σας συνδέσουμε σε ένα δίκτυο"

#: overlay/usr/lib/jiggity/firstboot.py:59
msgid "You need the internet for updates and the app store."
msgstr "Χρειάζεστε ίντερνετ για τις ενημερώσεις και το κατάστημα εφαρμογών."

#: overlay/usr/lib/jiggity/firstboot.py:71
#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Password:"
msgstr "Κωδικός:"

#: overlay/usr/lib/jiggity/firstboot.py:78
msgid "Connect"
msgstr "Σύνδεση"

#: overlay/usr/lib/jiggity/firstboot.py:78
msgid "Skip for now"
msgstr "Παράλειψη προς το παρόν"

#: overlay/usr/lib/jiggity/firstboot.py:91
msgid "No Wi-Fi networks found. You can skip this and connect later."
msgstr "Δεν βρέθηκαν δίκτυα Wi-Fi. Μπορείτε να το παραλείψετε και να συνδεθείτε αργότερα."

#: overlay/usr/lib/jiggity/firstboot.py:103
#, python-format
msgid "Connecting to %s..."
msgstr "Σύνδεση στο %s..."

#: overlay/usr/lib/jiggity/firstboot.py:108
#, python-format
msgid "Couldn't connect to %s. Check the password and try again."
msgstr "Δεν ήταν δυνατή η σύνδεση στο %s. Ελέγξτε τον κωδικό και δοκιμάστε ξανά."

#: overlay/usr/lib/jiggity/firstboot.py:113
msgid "Who's going to use this PC?"
msgstr "Ποιος θα χρησιμοποιεί αυτόν τον υπολογιστή;"

#: overlay/usr/lib/jiggity/firstboot.py:115
msgid "Your name"
msgstr "Το όνομά σας"

#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Name:"
msgstr "Όνομα:"

#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Username:"
msgstr "Όνομα χρήστη:"

#: overlay/usr/lib/jiggity/firstboot.py:120
msgid "Confirm password:"
msgstr "Επιβεβαίωση κωδικού:"

#: overlay/usr/lib/jiggity/firstboot.py:130
msgid "Back"
msgstr "Πίσω"

#: overlay/usr/lib/jiggity/firstboot.py:130
msgid "Next"
msgstr "Επόμενο"

#: overlay/usr/lib/jiggity/firstboot.py:139
msgid "The passwords don't match."
msgstr "Οι κωδικοί δεν ταιριάζουν."

#: overlay/usr/lib/jiggity/firstboot.py:149
msgid "Just a moment..."
msgstr "Μια στιγμή..."

#: overlay/usr/lib/jiggity/firstboot.py:167
#, python-format
msgid "That didn't work (%s). Try another username."
msgstr "Δεν πέτυχε (%s). Δοκιμάστε άλλο όνομα χρήστη."

