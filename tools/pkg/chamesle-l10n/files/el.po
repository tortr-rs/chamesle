msgid_plural "%d apps from Flathub and the Chamesle repo"
msgstr[0] "%d εφαρμογή από το Flathub και το αποθετήριο Chamesle"
msgstr[1] "%d εφαρμογές από το Flathub και το αποθετήριο Chamesle"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:514
msgid "Nothing found"
msgstr "Δεν βρέθηκε τίποτα"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:515
msgid "Try another word, or install a .deb or .rpm file from the menu."
msgstr "Δοκιμάστε άλλη λέξη ή εγκαταστήστε ένα αρχείο .deb ή .rpm από το μενού."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:524
msgid "Installed apps"
msgstr "Εγκατεστημένες εφαρμογές"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:542
msgid "Install updates automatically"
msgstr "Αυτόματη εγκατάσταση ενημερώσεων"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:543
msgid "Once a day while plugged in. A snapshot is taken first, so an update can be undone from the boot menu."
msgstr "Μία φορά την ημέρα με συνδεδεμένο φορτιστή. Πρώτα λαμβάνεται στιγμιότυπο, ώστε μια ενημέρωση να αναιρείται από το μενού εκκίνησης."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:550
msgid "Last automatic update"
msgstr "Τελευταία αυτόματη ενημέρωση"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:551
#, python-format
msgid "%(when)s, %(n)d update"
msgid_plural "%(when)s, %(n)d updates"
msgstr[0] "%(when)s, %(n)d ενημέρωση"
msgstr[1] "%(when)s, %(n)d ενημερώσεις"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:569
msgid "Updates wait for you now"
msgstr "Οι ενημερώσεις σας περιμένουν τώρα"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:569
msgid "Updates will install automatically"
msgstr "Οι ενημερώσεις θα εγκαθίστανται αυτόματα"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:582
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:987
msgid "Everything is up to date"
msgstr "Όλα είναι ενημερωμένα"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:587
#, python-format
msgid "%d update"
msgid_plural "%d updates"
msgstr[0] "%d ενημέρωση"
msgstr[1] "%d ενημερώσεις"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:589
msgid "Update all"
msgstr "Ενημέρωση όλων"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:604
msgid "Firmware"
msgstr "Υλικολογισμικό"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:605
msgid "Updates for the BIOS, the SSD and other parts, from the people who made them."
msgstr "Ενημερώσεις για το BIOS, τον SSD και άλλα εξαρτήματα, από τους κατασκευαστές τους."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:608
msgid "Firmware updates aren't installed"
msgstr "Οι ενημερώσεις υλικολογισμικού δεν είναι εγκατεστημένες"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:610
msgid "Checking for firmware updates…"
msgstr "Έλεγχος για ενημερώσεις υλικολογισμικού…"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:614
msgid "Your firmware is up to date"
msgstr "Το υλικολογισμικό σας είναι ενημερωμένο"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:620
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:631
msgid "Update"
msgstr "Ενημέρωση"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:627
#, python-format
msgid "Update the firmware of %s?"
msgstr "Ενημέρωση του υλικολογισμικού του %s;"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:628
msgid "Keep the computer plugged in. Some firmware is installed while the computer restarts: don't turn it off until it's back."
msgstr "Κρατήστε τον υπολογιστή στην πρίζα. Κάποιο υλικολογισμικό εγκαθίσταται κατά την επανεκκίνηση: μην τον κλείσετε μέχρι να επανέλθει."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:630
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:818
msgid "Cancel"
msgstr "Ακύρωση"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:637
#, python-format
msgid "Updating the firmware of %s"
msgstr "Ενημέρωση του υλικολογισμικού του %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:641
msgid "Restart the computer to finish the firmware update"
msgstr "Κάντε επανεκκίνηση για να ολοκληρωθεί η ενημέρωση του υλικολογισμικού"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:642
msgid "Firmware updated"
msgstr "Το υλικολογισμικό ενημερώθηκε"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:661
msgid "From"
msgstr "Από"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:664
#, python-format
msgid "From %s"
msgstr "Από %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:675
#, python-format
msgid "%d rating"
msgid_plural "%d ratings"
msgstr[0] "%d βαθμολογία"
msgstr[1] "%d βαθμολογίες"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:688
msgid "Install"
msgstr "Εγκατάσταση"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:688
msgid "Remove"
msgstr "Αφαίρεση"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:738
msgid "Reviews"
msgstr "Κριτικές"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:739
msgid "Write a review"
msgstr "Γράψτε μια κριτική"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:742
msgid "Install it first, then tell people what you think"
msgstr "Εγκαταστήστε το πρώτα και μετά πείτε τη γνώμη σας"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:747
msgid "Getting reviews…"
msgstr "Λήψη κριτικών…"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:767
msgid "No reviews yet"
msgstr "Δεν υπάρχουν ακόμα κριτικές"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:777
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:829
msgid "Someone"
msgstr "Κάποιος"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:785
#, python-format
msgid "Review %s"
msgstr "Κριτική για %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:786
msgid "Your review is shared with everyone who uses GNOME Software or the Chamesle Store."
msgstr "Η κριτική σας κοινοποιείται σε όλους όσοι χρησιμοποιούν το GNOME Software ή το Κατάστημα Chamesle."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:803
msgid "Your name (shown with the review)"
msgstr "Το όνομά σας (εμφανίζεται με την κριτική)"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:804
msgid "In a few words"
msgstr "Με λίγα λόγια"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:819
msgid "Send"
msgstr "Αποστολή"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:840
msgid "Thanks, your review is sent"
msgstr "Ευχαριστούμε, η κριτική σας στάλθηκε"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:840
#, python-format
msgid "The review didn't go through: %s"
msgstr "Η κριτική δεν στάλθηκε: %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:859
msgid "One thing at a time, the last one is still going"
msgstr "Ένα πράγμα τη φορά, το προηγούμενο εκτελείται ακόμα"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:882
msgid "Cancelled"
msgstr "Ακυρώθηκε"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:893
msgid "That didn't work"
msgstr "Αυτό δεν λειτούργησε"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:893
#, python-format
msgid "The full error is also saved in %s"
msgstr "Το πλήρες σφάλμα αποθηκεύτηκε επίσης στο %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:895
msgid "OK"
msgstr "Εντάξει"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:919
#, python-format
msgid "%(what)s · %(pkg)s (%(n)s of %(total)s)"
msgstr "%(what)s · %(pkg)s (%(n)s από %(total)s)"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:957
#, python-format
msgid "%(what)s (%(n)d of %(total)d: %(name)s)"
msgstr "%(what)s (%(n)d από %(total)d: %(name)s)"

