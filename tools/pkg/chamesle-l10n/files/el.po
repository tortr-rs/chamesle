msgstr "GeForce σειρές 400 και 500"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:19
msgid "GeForce 600 and 700 series"
msgstr "GeForce σειρές 600 και 700"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:20
msgid "GeForce 900 and 1000 series"
msgstr "GeForce σειρές 900 και 1000"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:21
msgid "GeForce 16, RTX and newer"
msgstr "GeForce 16, RTX και νεότερες"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:73
#, python-format
msgid "The NVIDIA driver is faster and needed for most games (%s)."
msgstr "Ο οδηγός της NVIDIA είναι πιο γρήγορος και χρειάζεται για τα περισσότερα παιχνίδια (%s)."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:74
#, python-format
msgid "NVIDIA driver (%s)"
msgstr "Οδηγός NVIDIA (%s)"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:74
#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:77
msgid "Open source driver (nouveau)"
msgstr "Οδηγός ανοιχτού κώδικα (nouveau)"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:76
msgid "This card is too old for the NVIDIA driver, the open source one is used."
msgstr "Αυτή η κάρτα είναι πολύ παλιά για τον οδηγό της NVIDIA, χρησιμοποιείται ο ανοιχτού κώδικα."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:79
msgid "This Wi-Fi chip needs Broadcom's driver to work."
msgstr "Αυτό το τσιπ Wi-Fi χρειάζεται τον οδηγό της Broadcom για να λειτουργήσει."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:80
msgid "Broadcom STA driver (wl)"
msgstr "Οδηγός Broadcom STA (wl)"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:81
msgid "Don't install it"
msgstr "Να μην εγκατασταθεί"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:84
msgid "Shared clipboard, window resizing and shared folders with your PC."
msgstr "Κοινό πρόχειρο, παράθυρο που προσαρμόζεται και κοινόχρηστοι φάκελοι με τον υπολογιστή σας."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:85
#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:88
#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:91
msgid "None"
msgstr "Κανένας"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:85
msgid "VirtualBox guest additions"
msgstr "Προσθήκες επισκέπτη VirtualBox"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:87
msgid "Shared clipboard, window resizing and better graphics."
msgstr "Κοινό πρόχειρο, παράθυρο που προσαρμόζεται και καλύτερα γραφικά."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:88
msgid "VMware tools"
msgstr "Εργαλεία VMware"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:90
msgid "HP printer or scanner"
msgstr "Εκτυπωτής ή σαρωτής HP"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:90
msgid "HP's own drivers support more printers and scanners."
msgstr "Οι δικοί της HP οδηγοί υποστηρίζουν περισσότερους εκτυπωτές και σαρωτές."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:91
msgid "HP drivers (hplip)"
msgstr "Οδηγοί HP (hplip)"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:103
#: tools/pkg/chamesle-drivers/files/usr/share/applications/org.chamesle.Drivers.desktop:3
msgid "Driver Manager"
msgstr "Διαχείριση οδηγών"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:107
msgid "Apply changes"
msgstr "Εφαρμογή αλλαγών"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:119
msgid "Looking at your hardware"
msgstr "Εξέταση του υλικού σας"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:130
msgid "Nothing to do"
msgstr "Τίποτα να γίνει"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:131
msgid "Your hardware works with the drivers that are already installed."
msgstr "Το υλικό σας λειτουργεί με τους οδηγούς που είναι ήδη εγκατεστημένοι."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:143
msgid "Recommended"
msgstr "Προτείνεται"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:143
msgid "installed"
msgstr "εγκατεστημένο"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:149
msgid "Installing a driver needs your password, and usually a restart after."
msgstr "Η εγκατάσταση οδηγού ζητά τον κωδικό σας, και συνήθως επανεκκίνηση μετά."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:159
msgid "Working on it, this can take a few minutes"
msgstr "Γίνεται, μπορεί να πάρει μερικά λεπτά"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:173
#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:151
msgid "Done"
msgstr "Έγινε"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:173
msgid "Restart the computer to start using the new driver."
msgstr "Κάντε επανεκκίνηση του υπολογιστή για να χρησιμοποιήσετε τον νέο οδηγό."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:174
msgid "Later"
msgstr "Αργότερα"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:175
msgid "Restart now"
msgstr "Επανεκκίνηση τώρα"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:179
#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:153
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:893
msgid "That didn't work"
msgstr "Αυτό δεν λειτούργησε"

#: tools/pkg/chamesle-drivers/files/usr/share/applications/org.chamesle.Drivers.desktop:4
msgid "Install drivers for your graphics card, Wi-Fi and printer"
msgstr "Εγκατάσταση οδηγών για κάρτα γραφικών, Wi-Fi και εκτυπωτή"

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:147
msgid "Started from before an update"
msgstr "Ξεκίνησε από πριν από μια ενημέρωση"

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:148
msgid "This is Chamesle as it was before the update of %s.\\n\\nIf that update broke something, keep this one and it's your system from the next restart. Your files stay as they are either way."
msgstr "Αυτό είναι το Chamesle όπως ήταν πριν από την ενημέρωση της %s.\\n\\nΑν εκείνη η ενημέρωση χάλασε κάτι, κρατήστε αυτό και από την επόμενη επανεκκίνηση θα είναι το σύστημά σας. Τα αρχεία σας μένουν όπως είναι σε κάθε περίπτωση."

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:149
msgid "Keep this one"
msgstr "Κράτησε αυτό"

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:149
msgid "Not now"
msgstr "Όχι τώρα"

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:151
msgid "Restart, and Chamesle starts as it is now."
msgstr "Κάντε επανεκκίνηση και το Chamesle θα ξεκινήσει όπως είναι τώρα."

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:153
msgid "Nothing was changed. Try again, or ask on the board."
msgstr "Δεν άλλαξε τίποτα. Δοκιμάστε ξανά ή ρωτήστε στο φόρουμ."

