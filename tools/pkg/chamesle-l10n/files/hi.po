#: overlay/usr/lib/jiggity/account.py:56
msgid "A username is lowercase letters and numbers, starting with a letter."
msgstr "उपयोगकर्ता नाम में छोटे अंग्रेज़ी अक्षर और अंक होते हैं, और यह किसी अक्षर से शुरू होता है।"

#: overlay/usr/lib/jiggity/account.py:58
msgid "That username is taken by the system. Pick another one."
msgstr "यह उपयोगकर्ता नाम सिस्टम पहले से इस्तेमाल करता है। कोई दूसरा चुनें।"

#: overlay/usr/lib/jiggity/account.py:97
msgid "A computer name is lowercase letters, numbers and dashes."
msgstr "कंप्यूटर के नाम में छोटे अंग्रेज़ी अक्षर, अंक और डैश होते हैं।"

#: overlay/usr/lib/jiggity/firstboot.py:32
msgid "Let's start with your time zone. Is this the right one?"
msgstr "चलिए आपके समय क्षेत्र से शुरू करते हैं। क्या यह सही है?"

#: overlay/usr/lib/jiggity/firstboot.py:33
msgid "It sets your clock. Type a city to find yours."
msgstr "इससे आपकी घड़ी सेट होती है। अपना ढूंढने के लिए किसी शहर का नाम लिखें।"

#: overlay/usr/lib/jiggity/firstboot.py:50
msgid "Yes"
msgstr "हाँ"

#: overlay/usr/lib/jiggity/firstboot.py:59
msgid "Let's connect you to a network"
msgstr "चलिए आपको किसी नेटवर्क से जोड़ते हैं"

#: overlay/usr/lib/jiggity/firstboot.py:59
msgid "You need the internet for updates and the app store."
msgstr "अपडेट और ऐप स्टोर के लिए आपको इंटरनेट चाहिए।"

#: overlay/usr/lib/jiggity/firstboot.py:71
#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Password:"
msgstr "पासवर्ड:"

#: overlay/usr/lib/jiggity/firstboot.py:78
msgid "Connect"
msgstr "कनेक्ट करें"

#: overlay/usr/lib/jiggity/firstboot.py:78
msgid "Skip for now"
msgstr "अभी छोड़ें"

#: overlay/usr/lib/jiggity/firstboot.py:91
msgid "No Wi-Fi networks found. You can skip this and connect later."
msgstr "कोई वाई-फ़ाई नेटवर्क नहीं मिला। आप इसे छोड़कर बाद में कनेक्ट कर सकते हैं।"

#: overlay/usr/lib/jiggity/firstboot.py:103
#, python-format
msgid "Connecting to %s..."
msgstr "%s से कनेक्ट हो रहा है..."

#: overlay/usr/lib/jiggity/firstboot.py:108
#, python-format
msgid "Couldn't connect to %s. Check the password and try again."
msgstr "%s से कनेक्ट नहीं हो सका। पासवर्ड जाँचें और फिर से कोशिश करें।"

#: overlay/usr/lib/jiggity/firstboot.py:113
msgid "Who's going to use this PC?"
msgstr "यह पीसी कौन इस्तेमाल करेगा?"

#: overlay/usr/lib/jiggity/firstboot.py:115
msgid "Your name"
msgstr "आपका नाम"

#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Name:"
msgstr "नाम:"

#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Username:"
msgstr "उपयोगकर्ता नाम:"

#: overlay/usr/lib/jiggity/firstboot.py:120
msgid "Confirm password:"
msgstr "पासवर्ड की पुष्टि करें:"

