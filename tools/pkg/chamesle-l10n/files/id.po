msgstr "Belum ada ulasan"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:777
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:829
msgid "Someone"
msgstr "Seseorang"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:785
#, python-format
msgid "Review %s"
msgstr "Ulas %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:786
msgid "Your review is shared with everyone who uses GNOME Software or the Chamesle Store."
msgstr "Ulasan Anda dibagikan kepada semua pengguna GNOME Software atau Toko Chamesle."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:803
msgid "Your name (shown with the review)"
msgstr "Nama Anda (ditampilkan bersama ulasan)"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:804
msgid "In a few words"
msgstr "Dalam beberapa kata"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:819
msgid "Send"
msgstr "Kirim"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:840
msgid "Thanks, your review is sent"
msgstr "Terima kasih, ulasan Anda terkirim"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:840
#, python-format
msgid "The review didn't go through: %s"
msgstr "Ulasan gagal dikirim: %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:859
msgid "One thing at a time, the last one is still going"
msgstr "Satu per satu, yang terakhir masih berjalan"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:882
msgid "Cancelled"
msgstr "Dibatalkan"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:893
msgid "That didn't work"
msgstr "Itu tidak berhasil"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:893
#, python-format
msgid "The full error is also saved in %s"
msgstr "Galat lengkap juga disimpan di %s"

