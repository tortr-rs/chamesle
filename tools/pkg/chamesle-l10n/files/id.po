msgstr "Pembaruan sekarang menunggu Anda"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:569
msgid "Updates will install automatically"
msgstr "Pembaruan akan dipasang secara otomatis"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:582
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:987
