msgstr "Perbarui semua"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:604
msgid "Firmware"
msgstr "Firmware"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:605
msgid "Updates for the BIOS, the SSD and other parts, from the people who made them."
msgstr "Pembaruan untuk BIOS, SSD, dan komponen lain, dari pembuatnya."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:608
msgid "Firmware updates aren't installed"
msgstr "Pembaruan firmware tidak terpasang"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:610
msgid "Checking for firmware updates…"
msgstr "Memeriksa pembaruan firmware…"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:614
msgid "Your firmware is up to date"
msgstr "Firmware Anda sudah mutakhir"

