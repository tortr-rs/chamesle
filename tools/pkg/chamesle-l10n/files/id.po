msgstr "Tulis ulasan"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:742
msgid "Install it first, then tell people what you think"
msgstr "Pasang dulu, lalu ceritakan pendapat Anda"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:747
msgid "Getting reviews…"
msgstr "Mengambil ulasan…"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:767
