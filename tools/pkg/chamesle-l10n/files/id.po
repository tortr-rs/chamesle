msgid "Installed apps"
msgstr "Aplikasi terpasang"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:542
msgid "Install updates automatically"
msgstr "Pasang pembaruan secara otomatis"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:543
msgid "Once a day while plugged in. A snapshot is taken first, so an update can be undone from the boot menu."
msgstr "Sekali sehari saat terhubung ke listrik. Snapshot dibuat lebih dulu, jadi pembaruan dapat dibatalkan dari menu boot."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:550
