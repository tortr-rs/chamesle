#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:514
msgid "Nothing found"
msgstr "Tidak ada yang ditemukan"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:515
msgid "Try another word, or install a .deb or .rpm file from the menu."
msgstr "Coba kata lain, atau pasang berkas .deb atau .rpm dari menu."

