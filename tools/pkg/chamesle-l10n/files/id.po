#, python-format
msgid "Update the firmware of %s?"
msgstr "Perbarui firmware %s?"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:628
msgid "Keep the computer plugged in. Some firmware is installed while the computer restarts: don't turn it off until it's back."
msgstr "Biarkan komputer tetap tersambung ke listrik. Sebagian firmware dipasang saat komputer dimulai ulang: jangan matikan sampai komputer menyala kembali."

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:630
#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:818
msgid "Cancel"
msgstr "Batal"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:637
#, python-format
msgid "Updating the firmware of %s"
msgstr "Memperbarui firmware %s"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:641
msgid "Restart the computer to finish the firmware update"
msgstr "Mulai ulang komputer untuk menyelesaikan pembaruan firmware"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:642
msgid "Firmware updated"
msgstr "Firmware diperbarui"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:661
