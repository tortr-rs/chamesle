msgstr "실패했습니다"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:893
#, python-format
msgid "The full error is also saved in %s"
msgstr "전체 오류는 %s에도 저장되어 있습니다"

#: tools/pkg/chamesle-store/files/usr/bin/chamesle-store:895
msgid "OK"
msgstr "확인"

