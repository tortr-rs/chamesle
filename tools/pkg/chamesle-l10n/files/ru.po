msgid "Keep this one"
msgstr "Оставить этот"

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:149
msgid "Not now"
msgstr "Не сейчас"

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:151
msgid "Restart, and Chamesle starts as it is now."
msgstr "Перезагрузитесь, и Chamesle запустится таким, какой он сейчас."

#: tools/pkg/chamesle-snapshots/files/usr/bin/chamesle-snapshot:153
msgid "Nothing was changed. Try again, or ask on the board."
msgstr "Ничего не изменилось. Попробуйте ещё раз или спросите на форуме."

