msgid "It sets your clock. Type a city to find yours."
msgstr "По нему идут часы. Введите город, чтобы найти свой."

#: overlay/usr/lib/jiggity/firstboot.py:50
msgid "Yes"
msgstr "Да"

#: overlay/usr/lib/jiggity/firstboot.py:59
msgid "Let's connect you to a network"
msgstr "Подключимся к сети"

#: overlay/usr/lib/jiggity/firstboot.py:59
msgid "You need the internet for updates and the app store."
msgstr "Интернет нужен для обновлений и магазина приложений."

