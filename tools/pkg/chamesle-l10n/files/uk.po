msgid "Recommended"
msgstr "Рекомендовано"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:143
msgid "installed"
msgstr "встановлено"

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:149
msgid "Installing a driver needs your password, and usually a restart after."
msgstr "Для встановлення драйвера потрібен ваш пароль, а потім зазвичай перезапуск."

#: tools/pkg/chamesle-drivers/files/usr/bin/chamesle-drivers:159
msgid "Working on it, this can take a few minutes"
msgstr "Працюємо, це може зайняти кілька хвилин"

