#, python-format
msgid "Connecting to %s..."
msgstr "Đang kết nối với %s..."

#: overlay/usr/lib/jiggity/firstboot.py:108
#, python-format
msgid "Couldn't connect to %s. Check the password and try again."
msgstr "Không kết nối được với %s. Hãy kiểm tra mật khẩu và thử lại."

#: overlay/usr/lib/jiggity/firstboot.py:113
msgid "Who's going to use this PC?"
msgstr "Ai sẽ dùng chiếc PC này?"

#: overlay/usr/lib/jiggity/firstboot.py:115
msgid "Your name"
msgstr "Tên của bạn"

#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Name:"
msgstr "Tên:"

#: overlay/usr/lib/jiggity/firstboot.py:119
msgid "Username:"
msgstr "Tên người dùng:"

#: overlay/usr/lib/jiggity/firstboot.py:120
msgid "Confirm password:"
msgstr "Nhập lại mật khẩu:"

#: overlay/usr/lib/jiggity/firstboot.py:130
msgid "Back"
msgstr "Quay lại"

#: overlay/usr/lib/jiggity/firstboot.py:130
msgid "Next"
msgstr "Tiếp"

#: overlay/usr/lib/jiggity/firstboot.py:139
msgid "The passwords don't match."
msgstr "Hai mật khẩu không khớp."

#: overlay/usr/lib/jiggity/firstboot.py:149
msgid "Just a moment..."
msgstr "Chờ một chút..."

#: overlay/usr/lib/jiggity/firstboot.py:167
#, python-format
msgid "That didn't work (%s). Try another username."
msgstr "Không được (%s). Hãy thử tên người dùng khác."

