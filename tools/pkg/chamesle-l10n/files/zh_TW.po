msgid "Back"
msgstr "返回"

#: overlay/usr/lib/jiggity/firstboot.py:130
msgid "Next"
msgstr "下一步"

#: overlay/usr/lib/jiggity/firstboot.py:139
msgid "The passwords don't match."
msgstr "兩次輸入的密碼不一樣。"

