#!/bin/sh
# dinit through /usr/lib/chamesle/init, so it starts the blue screen on its own when the system can't finish
# starting. systems installed before 0.5 get it added to their boot line here
g=/etc/default/grub
if [ -f $g ] && [ -x /usr/bin/dinit ] && ! grep -q 'init=' $g; then
    sed -i 's|^\(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*\)"|\1 init=/usr/lib/chamesle/init"|' $g
    [ -f /boot/grub/grub.cfg ] && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
fi
exit 0
