#!/usr/bin/python3
# Chamesle Store: apps from Flathub and from the Chamesle repo in one place, plus .deb/.rpm files through pkgimport,
# firmware through fwupd. ratings and reviews are gnome's odrs, the ones gnome software shows
import gzip, hashlib, json, os, re, subprocess, sys, threading, time, urllib.request
import xml.etree.ElementTree as ET

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, GObject, Gtk, Pango

APPSTREAM = "/var/lib/flatpak/appstream/flathub/x86_64/active"
CACHE = os.path.join(GLib.get_user_cache_dir(), "chamesle-store")
HELPER = "/usr/libexec/chamesle-store-helper"
ODRS = "https://odrs.gnome.org/1.0/reviews/api"
AUTO_CONF = "/etc/chamesle/updates.conf"
AUTO_STATE = "/var/lib/chamesle/auto-update"
# bump when the flathub cache gets new fields
CACHE_V = 2

CSS = b"""
.stars { color: #e5a50a; }
.stars-off { color: alpha(currentColor, .25); }
.shot { border-radius: 8px; }
"""

FEATURED = ["com.spotify.Client", "com.discordapp.Discord", "com.valvesoftware.Steam", "com.obsproject.Studio",
            "org.gimp.GIMP", "org.libreoffice.LibreOffice", "org.videolan.VLC", "org.telegram.desktop",
            "org.kde.krita", "org.blender.Blender", "com.visualstudio.code", "org.inkscape.Inkscape"]

# freedesktop categories -> what the store shows
CATEGORIES = [
    ("Games", "Game", "applications-games-symbolic"),
    ("Internet", "Network", "applications-internet-symbolic"),
    ("Music & Video", "AudioVideo", "applications-multimedia-symbolic"),
    ("Graphics & Photos", "Graphics", "applications-graphics-symbolic"),
    ("Office", "Office", "x-office-document-symbolic"),
    ("Development", "Development", "applications-engineering-symbolic"),
    ("Education & Science", "Education", "applications-science-symbolic"),
    ("Utilities", "Utility", "applications-utilities-symbolic"),
    ("System", "System", "applications-system-symbolic"),
]


class Source:
    def __init__(self, kind, ref, summary="", description="", icon=None, shots=None, version=""):
        self.kind, self.ref, self.summary, self.description, self.icon = kind, ref, summary, description, icon
        self.shots, self.version = shots or [], version

    @property
    def label(self):
        return "Flathub" if self.kind == "flathub" else "Chamesle"


class App:
    def __init__(self, name):
        self.name, self.sources, self.categories = name, [], set()

    def source(self, kind):
        return next((s for s in self.sources if s.kind == kind), None)

    @property
    def summary(self):
        return next((s.summary for s in self.sources if s.summary), "")

    @property
    def icon(self):
        return next((s.icon for s in self.sources if s.icon), None)

    @property
    def flathub(self):
        return self.source("flathub")


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def repo_url():
    try:
        for line in open("/etc/apk/repositories"):
            parts = line.split()
            if parts and not line.startswith("#"):
                url = parts[-1]
                if url.startswith("http"):
                    return url.rstrip("/") + "/x86_64"
    except OSError:
        pass
    return None


def text_of(el):
    # appstream descriptions: <p> and <li>, as plain paragraphs
    out = []
    for c in el:
        if c.tag == "p":
            out.append("".join(c.itertext()).strip())
        elif c.tag in ("ul", "ol"):
            out += ["• " + "".join(li.itertext()).strip() for li in c]
    return "\n\n".join(x for x in out if x)


def user_hash():
    # odrs knows a reviewer by this, never by name: the same on every run, different on every machine
    try:
        mid = open("/etc/machine-id").read().strip()
    except OSError:
        mid = ""
    return hashlib.sha1(("chamesle-store[%s:%s]" % (GLib.get_user_name(), mid)).encode()).hexdigest()


def post(url, data):
    req = urllib.request.Request(url, json.dumps(data).encode(), {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=20))


def stars(avg, size=None):
    # five stars, the filled ones gold
    box = Gtk.Box(spacing=1)
    for i in range(5):
        l = Gtk.Label(label="★", css_classes=["stars" if avg >= i + 0.5 else "stars-off"])
        if size:
            l.add_css_class(size)
        box.append(l)
    return box


class Catalog:
    def __init__(self):
        self.apps = {}
        self.ratings = {}
        self.by_flathub, self.by_pkg = {}, {}
        self.installed_apk, self.installed_flatpak = set(), set()

    def add(self, name, source, categories):
        key = name.lower()
        app = self.apps.setdefault(key, App(name))
        if not app.source(source.kind):
            app.sources.append(source)
        app.categories |= set(categories)
        (self.by_flathub if source.kind == "flathub" else self.by_pkg)[source.ref] = app

    def load_flathub(self):
        path = None
        for p in ("appstream.xml.gz", "appstream.xml"):
            if os.path.exists(os.path.join(APPSTREAM, p)):
                path = os.path.join(APPSTREAM, p)
                break
        if not path:
            run(["flatpak", "update", "--appstream", "flathub"])
            return self.load_flathub() if os.path.exists(os.path.join(APPSTREAM, "appstream.xml.gz")) else None
        # parsing flathub's list takes a while: keep the result until flatpak downloads a new one
        cached = os.path.join(CACHE, "flathub.json")
        stamp = os.path.getmtime(path)
        try:
            c = json.load(open(cached))
            if c["stamp"] == stamp and c.get("v") == CACHE_V:
                for a in c["apps"]:
                    self.add(a[0], Source("flathub", a[1], a[2], a[3], a[4], a[6], a[7]), a[5])
                return
        except (OSError, ValueError, KeyError):
            pass
        keep = []
        data = gzip.open(path).read() if path.endswith(".gz") else open(path, "rb").read()
        for comp in ET.fromstring(data).iter("component"):
            if comp.get("type") not in ("desktop-application", "desktop"):
                continue
            cid = comp.findtext("id")
            name = next((n.text for n in comp.findall("name") if not n.get("{http://www.w3.org/XML/1998/namespace}lang")), None)
            if not cid or not name:
                continue
            summary = next((n.text for n in comp.findall("summary")
                            if not n.get("{http://www.w3.org/XML/1998/namespace}lang")), "") or ""
            desc = comp.find("description")
            icon = None
            for ic in comp.findall("icon"):
                if ic.get("type") == "cached":
                    for size in ("128x128", "64x64"):
                        p = os.path.join(APPSTREAM, "icons", size, ic.text)
                        if os.path.exists(p):
                            icon = p
                            break
                if icon:
                    break
            cats = [c.text for c in comp.iter("category") if c.text]
            desc = text_of(desc) if desc is not None else ""
            # screenshots: flathub's 624 wide thumbnails, or the closest it has
            shots = []
            for sh in comp.iter("screenshot"):
                imgs = [(int(i.get("width") or 0), i.text) for i in sh.findall("image") if i.text]
                thumbs = [x for x in imgs if 500 <= x[0] <= 800] or sorted(imgs)
                if thumbs:
                    shots.append(thumbs[0][1].strip())
            rel = comp.find("releases/release")
            version = rel.get("version", "") if rel is not None else ""
            self.add(name, Source("flathub", cid, summary, desc, icon, shots[:6], version), cats)
            keep.append([name, cid, summary, desc, icon, cats, shots[:6], version])
        os.makedirs(CACHE, exist_ok=True)
        json.dump({"stamp": stamp, "v": CACHE_V, "apps": keep}, open(cached, "w"))

    def load_repo(self):
        url = repo_url()
        os.makedirs(os.path.join(CACHE, "icons"), exist_ok=True)
        local = os.path.join(CACHE, "apps.json")
        try:
            urllib.request.urlretrieve(url + "/apps.json", local)
        except Exception:
            pass
        if not os.path.exists(local):
            return
        for a in json.load(open(local)):
            icon = ("repo", a["icon"]) if a.get("icon") else None
            self.add(a["name"], Source("apk", a["pkg"], a.get("summary", ""), "", icon), a.get("categories", []))

    def load_ratings(self):
        # every app's star counts in one 2 MB file, fetched again once a day
        path = os.path.join(CACHE, "ratings.json")
        try:
            if not os.path.exists(path) or time.time() - os.path.getmtime(path) > 86400:
                urllib.request.urlretrieve(ODRS + "/ratings", path + ".new")
                os.replace(path + ".new", path)
            self.ratings = json.load(open(path))
        except Exception:
            pass

    def rating(self, app):
        # (average out of 5, how many), or None
        f = app.flathub
        r = f and (self.ratings.get(f.ref) or self.ratings.get(f.ref + ".desktop"))
        if not r or not r.get("total"):
            return None
        n = sum(r.get("star%d" % i, 0) for i in range(1, 6))
        if not n:
            return None
        return sum(i * r.get("star%d" % i, 0) for i in range(1, 6)) / n, n

    def load_installed(self):
        self.installed_apk = set(run(["apk", "info", "--quiet"]).stdout.split())
        self.installed_flatpak = set(run(["flatpak", "list", "--app", "--columns=application"]).stdout.split())

    def installed(self, app):
        return [s for s in app.sources if (s.kind == "apk" and s.ref in self.installed_apk) or
                (s.kind == "flathub" and s.ref in self.installed_flatpak)]

    def updates(self):
        # "bash-5.3-r2   < 5.3-r3": installed, newer one in the repo (works without root)
        apk = []
        for line in run(["apk", "version", "-l", "<"]).stdout.splitlines():
            m = re.match(r"(\S+)-([^-\s]+-r\d+)\s+<\s+(\S+)", line)
            if m:
                apk.append(m.groups())
        flat = run(["flatpak", "remote-ls", "--updates", "--app", "--columns=application"]).stdout.split()
        return apk, flat

    def firmware(self):
        # devices fwupd has a newer firmware for: [(device id, name, version now, release)], None without fwupd
        if not os.path.exists("/usr/bin/fwupdmgr"):
            return None
        p = run(["fwupdmgr", "get-updates", "--json"])
        try:
            devs = json.loads(p.stdout).get("Devices", [])
        except ValueError:
            return []
        out = []
        for d in devs:
            rels = d.get("Releases") or []
            if rels and d.get("DeviceId"):
                out.append((d["DeviceId"], d.get("Name", "Device"), d.get("Version", ""), rels[0]))
        return out

    def needs_reboot(self):
        try:
            devs = json.loads(run(["fwupdmgr", "get-devices", "--json"]).stdout).get("Devices", [])
        except ValueError:
            return False
        return any("needs-reboot" in (d.get("Flags") or []) for d in devs)


def icon_widget(app, size):
    img = Gtk.Image(pixel_size=size)
    icon = app.icon
    if icon is None:
        img.set_from_icon_name("application-x-executable")
    elif isinstance(icon, tuple):
        # our repo's icons are fetched the first time they're shown
        name = icon[1]
        path = os.path.join(CACHE, "icons", name)
        if os.path.exists(path):
            img.set_from_file(path)
        else:
            img.set_from_icon_name("application-x-executable")

            def fetch():
                try:
                    urllib.request.urlretrieve(repo_url() + "/icons/" + name, path)
                    GLib.idle_add(img.set_from_file, path)
                except Exception:
                    pass
            threading.Thread(target=fetch, daemon=True).start()
    else:
        img.set_from_file(icon)
    return img


class Store(Adw.Application):
    def __init__(self, updates=False):
        super().__init__(application_id="org.chamesle.Store", flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.catalog = Catalog()
        self.busy = False
        self.start_on_updates = updates

    # ---- window

    def do_activate(self):
        win = self.get_active_window()
        if win:
            win.present()
            return
        css = Gtk.CssProvider()
        css.load_from_data(CSS, -1)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win = Adw.ApplicationWindow(application=self, title="Store", default_width=1000, default_height=720)
        self.toasts = Adw.ToastOverlay()
        self.nav = Adw.NavigationView()
        self.prog = Gtk.ProgressBar(hexpand=True, valign=Gtk.Align.CENTER)
        self.prog_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, width_chars=30)
        bar = Gtk.Box(spacing=12, margin_top=8, margin_bottom=8, margin_start=12, margin_end=12)
        bar.append(Gtk.Spinner(spinning=True))
        bar.append(self.prog_label)
        bar.append(self.prog)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        inner.append(Gtk.Separator())
        inner.append(bar)
        self.prog_bar = Gtk.Revealer(child=inner, transition_type=Gtk.RevealerTransitionType.SLIDE_UP)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.nav.set_vexpand(True)
        outer.append(self.nav)
        outer.append(self.prog_bar)
        self.toasts.set_child(outer)
        self.win.set_content(self.toasts)

        self.stack = Adw.ViewStack()
        self.explore = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.installed_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.updates_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.stack.add_titled_with_icon(self.scrolled(self.explore), "explore", "Explore", "system-search-symbolic")
        self.stack.add_titled_with_icon(self.scrolled(self.installed_page), "installed", "Installed", "emblem-ok-symbolic")
        self.updates_title = self.stack.add_titled_with_icon(self.scrolled(self.updates_page), "updates", "Updates",
                                                             "software-update-available-symbolic")
        self.stack.connect("notify::visible-child-name", lambda *a: self.refresh_tab())

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        self.search_button = Gtk.ToggleButton(icon_name="system-search-symbolic", tooltip_text="Search")
        header.pack_start(self.search_button)
        menu = Gio.Menu()
        menu.append("Install a .deb or .rpm file…", "app.import")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu))
        act = Gio.SimpleAction.new("import", None)
        act.connect("activate", lambda *a: self.pick_file())
        self.add_action(act)

        self.search = Gtk.SearchEntry(placeholder_text="Search apps", hexpand=True)
        bar = Gtk.SearchBar(child=Adw.Clamp(child=self.search, maximum_size=600))
        bar.connect_entry(self.search)
        bar.set_key_capture_widget(self.win)
        self.search_button.bind_property("active", bar, "search-mode-enabled",
                                         GObject.BindingFlags.BIDIRECTIONAL)
        self.search.connect("search-changed", lambda e: self.do_search(e.get_text()))

        self.results = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.main_stack = Gtk.Stack()
        self.main_stack.add_named(self.stack, "tabs")
        self.main_stack.add_named(self.scrolled(self.results), "search")
        self.loading = Adw.StatusPage(title="Getting the app lists ready", description="This takes a moment the first time.")
        self.loading.set_child(Gtk.Spinner(spinning=True, width_request=32, height_request=32))
        self.main_stack.add_named(self.loading, "loading")
        self.main_stack.set_visible_child_name("loading")

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.add_top_bar(bar)
        view.set_content(self.main_stack)
        self.nav.add(Adw.NavigationPage(child=view, title="Store", tag="main"))
        self.win.present()
        threading.Thread(target=self.load, daemon=True).start()

    def do_open(self, files, n, hint):
        # double-clicked .deb/.rpm files can be opened with the store too
        self.activate()
        for f in files:
            self.import_file(f.get_path())

    def scrolled(self, child):
        clamp = Adw.Clamp(child=child, maximum_size=1000, margin_top=18, margin_bottom=24, margin_start=12, margin_end=12)
        return Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))

    # ---- data

    def load(self):
        self.catalog.load_flathub()
        self.catalog.load_repo()
        self.catalog.load_ratings()
        self.catalog.load_installed()
        GLib.idle_add(self.loaded)

    def loaded(self):
        self.main_stack.set_visible_child_name("tabs")
        if self.start_on_updates:
            self.stack.set_visible_child_name("updates")
        self.fill_explore()
        self.refresh_tab()
        threading.Thread(target=self.check_updates, daemon=True).start()

    def check_updates(self):
        apk, flat = self.catalog.updates()
        GLib.idle_add(self.show_updates, apk, flat, None)
        fw = self.catalog.firmware()
        GLib.idle_add(self.show_updates, apk, flat, fw)

    # ---- pages

    def clear(self, box):
        while box.get_first_child():
            box.remove(box.get_first_child())

    def heading(self, text):
        return Gtk.Label(label=text, xalign=0, css_classes=["title-2"], margin_top=18, margin_bottom=10)

    def tile(self, app):
        b = Gtk.Button(css_classes=["card"], width_request=220)
        box = Gtk.Box(spacing=12, margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        box.append(icon_widget(app, 48))
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        text.append(Gtk.Label(label=app.name, xalign=0, css_classes=["heading"], ellipsize=Pango.EllipsizeMode.END))
        text.append(Gtk.Label(label=app.summary, xalign=0, css_classes=["dim-label", "caption"],
                              ellipsize=Pango.EllipsizeMode.END, max_width_chars=28))
        r = self.catalog.rating(app)
        if r and r[1] >= 5:
            line = Gtk.Box(spacing=6)
            line.append(stars(r[0], "caption"))
            line.append(Gtk.Label(label="%d" % r[1], css_classes=["dim-label", "caption"]))
            text.append(line)
        box.append(text)
        b.set_child(box)
        b.connect("clicked", lambda *a: self.show_app(app))
        return b

    def grid(self, apps):
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, max_children_per_line=4,
                           column_spacing=12, row_spacing=12)
        for a in apps:
            flow.append(self.tile(a))
        return flow

    def fill_explore(self):
        self.clear(self.explore)
        featured = [self.catalog.by_flathub[i] for i in FEATURED if i in self.catalog.by_flathub]
        if featured:
            self.explore.append(self.heading("Popular"))
            self.explore.append(self.grid(featured))
        self.explore.append(self.heading("Categories"))
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, max_children_per_line=3,
                           column_spacing=12, row_spacing=12)
        for title, cat, icon in CATEGORIES:
            b = Gtk.Button(css_classes=["card"])
            box = Gtk.Box(spacing=10, margin_top=16, margin_bottom=16, margin_start=16, margin_end=16)
            box.append(Gtk.Image(icon_name=icon, pixel_size=24))
            box.append(Gtk.Label(label=title, css_classes=["heading"]))
            b.set_child(box)
            b.connect("clicked", lambda w, t=title, c=cat: self.show_category(t, c))
            flow.append(b)
        self.explore.append(flow)
        n = len(self.catalog.apps)
        self.explore.append(Gtk.Label(label="%d apps from Flathub and the Chamesle repo" % n,
                                      css_classes=["dim-label", "caption"], margin_top=24))

    def show_category(self, title, cat):
        apps = sorted((a for a in self.catalog.apps.values() if cat in a.categories), key=lambda a: a.name.lower())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.grid(apps[:300]))
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(self.scrolled(box))
        self.nav.push(Adw.NavigationPage(child=view, title=title))

    def do_search(self, text):
        text = text.strip().lower()
        if not text:
            self.main_stack.set_visible_child_name("tabs")
            return
        self.main_stack.set_visible_child_name("search")
        self.clear(self.results)
        hits = [a for a in self.catalog.apps.values() if text in a.name.lower() or text in a.summary.lower()]
        hits.sort(key=lambda a: (not a.name.lower().startswith(text), text not in a.name.lower(), a.name.lower()))
        if not hits:
            self.results.append(Adw.StatusPage(icon_name="system-search-symbolic", title="Nothing found",
                                               description="Try another word, or install a .deb or .rpm file from the menu."))
            return
        self.results.append(self.grid(hits[:120]))

    def refresh_tab(self):
        name = self.stack.get_visible_child_name()
        if name == "installed":
            self.clear(self.installed_page)
            apps = sorted((a for a in self.catalog.apps.values() if self.catalog.installed(a)), key=lambda a: a.name.lower())
            self.installed_page.append(self.heading("Installed apps"))
            group = Adw.PreferencesGroup()
            for a in apps:
                row = Adw.ActionRow(title=GLib.markup_escape_text(a.name),
                                    subtitle=", ".join(s.label for s in self.catalog.installed(a)), activatable=True)
                row.add_prefix(icon_widget(a, 32))
                row.connect("activated", lambda r, a=a: self.show_app(a))
                group.add(row)
            self.installed_page.append(group)

    def auto_group(self):
        # updates on their own, and when they last happened
        group = Adw.PreferencesGroup(margin_bottom=18)
        on = True
        try:
            on = not any(l.strip() == "auto=no" for l in open(AUTO_CONF))
        except OSError:
            pass
        row = Adw.SwitchRow(title="Install updates automatically", active=on,
                            subtitle="Once a day while plugged in. A snapshot is taken first, so an update can be "
                                     "undone from the boot menu.")
        row.connect("notify::active", lambda r, *a: self.set_auto(r))
        group.add(row)
        try:
            when, n = open(AUTO_STATE).read().split()[:2]
            last = GLib.DateTime.new_from_unix_local(int(when)).format("%A %-d %B, %H:%M")
            group.add(Adw.ActionRow(title="Last automatic update", subtitle="%s, %s update%s" % (
                last, n, "" if n == "1" else "s")))
        except (OSError, ValueError):
            pass
        return group

    def set_auto(self, row):
        # the switch flipping back after a cancelled password asks nothing
        if getattr(self, "reverting", False):
            self.reverting = False
            return
        want = row.get_active()

        def go():
            ok = subprocess.run(["pkexec", HELPER, "auto", "on" if want else "off"], capture_output=True).returncode == 0
            GLib.idle_add(done, ok)

        def done(ok):
            if ok:
                self.toast("Updates will install automatically" if want else "Updates wait for you now")
            else:
                self.reverting = True
                row.set_active(not want)
        threading.Thread(target=go, daemon=True).start()

    def show_updates(self, apk, flat, fw):
        self.clear(self.updates_page)
        self.updates_page.append(self.auto_group())
        total = len(apk) + len(flat) + len(fw or [])
        self.updates_title.set_needs_attention(total > 0)
        self.updates_title.set_badge_number(total)
        if not len(apk) + len(flat):
            self.updates_page.append(Adw.StatusPage(icon_name="emblem-ok-symbolic", title="Everything is up to date",
                                                    vexpand=False))
        else:
            top = Gtk.Box(spacing=12, margin_top=6, margin_bottom=12)
            top.append(Gtk.Label(label="%d updates" % (len(apk) + len(flat)), xalign=0, hexpand=True,
                                 css_classes=["title-2"]))
            go = Gtk.Button(label="Update all", css_classes=["suggested-action", "pill"])
            go.connect("clicked", lambda *a: self.update_all())
            top.append(go)
            self.updates_page.append(top)
            group = Adw.PreferencesGroup()
            for name, old, new in apk:
                group.add(Adw.ActionRow(title=name, subtitle="%s → %s" % (old, new)))
            for ref in flat:
                app = self.catalog.by_flathub.get(ref)
                group.add(Adw.ActionRow(title=GLib.markup_escape_text(app.name if app else ref), subtitle="Flathub"))
            self.updates_page.append(group)
        self.updates_page.append(self.firmware_group(fw))

    def firmware_group(self, fw):
        # the computer's own firmware: bios, ssd, docks, touchpads... from the vendors, through lvfs
        group = Adw.PreferencesGroup(title="Firmware", margin_top=24,
                                     description="Updates for the BIOS, the SSD and other parts, from the people "
                                                 "who made them.")
        if fw is None and not os.path.exists("/usr/bin/fwupdmgr"):
            group.add(Adw.ActionRow(title="Firmware updates aren't installed", subtitle="sudo apk add fwupd"))
        elif fw is None:
            row = Adw.ActionRow(title="Checking for firmware updates…")
            row.add_suffix(Gtk.Spinner(spinning=True))
            group.add(row)
        elif not fw:
            group.add(Adw.ActionRow(title="Your firmware is up to date"))
        for dev, name, now, rel in fw or []:
            row = Adw.ActionRow(title=GLib.markup_escape_text(name),
                                subtitle=GLib.markup_escape_text("%s → %s%s" % (
                                    now, rel.get("Version", "?"),
                                    (" · " + rel["Summary"]) if rel.get("Summary") else "")))
            b = Gtk.Button(label="Update", valign=Gtk.Align.CENTER, css_classes=["pill"])
            b.connect("clicked", lambda w, d=dev, n=name: self.update_firmware(d, n))
            row.add_suffix(b)
            group.add(row)
        return group

    def update_firmware(self, dev, name):
        d = Adw.AlertDialog(heading="Update the firmware of %s?" % name,
                            body="Keep the computer plugged in. Some firmware is installed while the computer "
                                 "restarts: don't turn it off until it's back.")
        d.add_response("cancel", "Cancel")
        d.add_response("go", "Update")
        d.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(d, r):
            if r != "go":
                return
            title = "Updating the firmware of " + name

            def after():
                if self.catalog.needs_reboot():
                    self.toast("Restart the computer to finish the firmware update")
            self.job(title, self.apk_job(["firmware", dev], title), "Firmware updated", after)
        d.connect("response", answered)
        d.present(self.win)

    def show_app(self, app):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        top = Gtk.Box(spacing=18)
        top.append(icon_widget(app, 96))
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True, spacing=4)
        info.append(Gtk.Label(label=app.name, xalign=0, css_classes=["title-1"], wrap=True))
        info.append(Gtk.Label(label=app.summary, xalign=0, wrap=True, css_classes=["dim-label"]))
        top.append(info)
        page.append(top)

        # where to get it from, flathub first when both have it
        sources = sorted(app.sources, key=lambda s: s.kind != "flathub")
        choice = Gtk.DropDown.new_from_strings([s.label for s in sources])
        row = Gtk.Box(spacing=12)
        if len(sources) > 1:
            row.append(Gtk.Label(label="From"))
            row.append(choice)
        else:
            row.append(Gtk.Label(label="From " + sources[0].label, css_classes=["dim-label"]))
        spacer = Gtk.Box(hexpand=True)
        row.append(spacer)
        button = Gtk.Button(css_classes=["pill"])
        row.append(button)
        page.append(row)
        r = self.catalog.rating(app)
        if r:
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Label(label="%.1f" % r[0], css_classes=["title-3"]))
            line.append(stars(r[0]))
            line.append(Gtk.Label(label="%d ratings" % r[1], css_classes=["dim-label"]))
            info.append(line)
        f = app.flathub
        if f and f.shots:
            page.append(self.screenshots(f.shots))
        desc = Gtk.Label(xalign=0, wrap=True, selectable=True, margin_top=12)
        page.append(desc)
        if f:
            page.append(self.reviews(app, f))

        def update(*a):
            s = sources[choice.get_selected()]
            inst = s in self.catalog.installed(app)
            button.set_label("Remove" if inst else "Install")
            button.set_css_classes(["pill", "destructive-action" if inst else "suggested-action"])
            desc.set_label(s.description or s.summary or "")
        choice.connect("notify::selected", update)
        button.connect("clicked", lambda *a: self.install_or_remove(app, sources[choice.get_selected()], update))
        update()

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(self.scrolled(page))
        self.nav.push(Adw.NavigationPage(child=view, title=app.name))

    def screenshots(self, urls):
        # a row you swipe or click through, each picture fetched once into the cache
        car = Adw.Carousel(allow_scroll_wheel=False, spacing=12, height_request=360)
        os.makedirs(os.path.join(CACHE, "shots"), exist_ok=True)
        for url in urls:
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, hexpand=True, css_classes=["shot"])
            path = os.path.join(CACHE, "shots", hashlib.sha1(url.encode()).hexdigest() + ".png")

            def fetch(url=url, path=path, pic=pic):
                try:
                    if not os.path.exists(path):
                        urllib.request.urlretrieve(url, path + ".part")
                        os.replace(path + ".part", path)
                    GLib.idle_add(pic.set_filename, path)
                except Exception:
                    pass
            threading.Thread(target=fetch, daemon=True).start()
            car.append(pic)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=12)
        over = Gtk.Overlay(child=car)
        for icon, step, align in (("go-previous-symbolic", -1, Gtk.Align.START), ("go-next-symbolic", 1, Gtk.Align.END)):
            b = Gtk.Button(icon_name=icon, halign=align, valign=Gtk.Align.CENTER, margin_start=6, margin_end=6,
                           css_classes=["circular", "osd"], visible=len(urls) > 1)

            def go(b, step=step):
                i = int(round(car.get_position())) + step
                if 0 <= i < car.get_n_pages():
                    car.scroll_to(car.get_nth_page(i), True)
            b.connect("clicked", go)
            over.add_overlay(b)
        box.append(over)
        if len(urls) > 1:
            box.append(Adw.CarouselIndicatorDots(carousel=car))
        return box

    def reviews(self, app, src):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        top = Gtk.Box(spacing=12, margin_top=18)
        top.append(Gtk.Label(label="Reviews", xalign=0, hexpand=True, css_classes=["title-2"]))
        write = Gtk.Button(label="Write a review", css_classes=["pill"])
        write.connect("clicked", lambda *a: self.write_review(app, src))
        write.set_sensitive(src in self.catalog.installed(app))
        write.set_tooltip_text(None if write.get_sensitive() else "Install it first, then tell people what you think")
        top.append(write)
        box.append(top)
        group = Adw.PreferencesGroup()
        box.append(group)
        wait = Adw.ActionRow(title="Getting reviews…")
        group.add(wait)

        def fetch():
            try:
                got = post(ODRS + "/fetch", {"app_id": src.ref, "locale": "en_US", "distro": "Chamesle",
                                             "version": src.version or "unknown", "user_hash": user_hash(), "limit": 5})
            except Exception:
                got = None
            GLib.idle_add(show, got)

        def show(got):
            group.remove(wait)
            got = [g for g in (got or []) if isinstance(g, dict) and g.get("summary")]
            if not got:
                group.add(Adw.ActionRow(title="No reviews yet"))
                return
            # odrs hands back a key with the reviews, needed to write one
            self.skeys = getattr(self, "skeys", {})
            self.skeys[src.ref] = got[0].get("user_skey")
            for g in got[:5]:
                r = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=12, margin_bottom=12,
                            margin_start=12, margin_end=12)
                head = Gtk.Box(spacing=8)
                head.append(stars(g.get("rating", 0) / 20))
                head.append(Gtk.Label(label=g["summary"], xalign=0, css_classes=["heading"], wrap=True))
                r.append(head)
                when = GLib.DateTime.new_from_unix_local(int(g.get("date_created", 0))).format("%-d %B %Y")
                r.append(Gtk.Label(label="%s · %s" % (g.get("user_display") or "Someone", when), xalign=0,
                                   css_classes=["dim-label", "caption"]))
                r.append(Gtk.Label(label=g.get("description", ""), xalign=0, wrap=True, selectable=True))
                group.add(r)
        threading.Thread(target=fetch, daemon=True).start()
        return box

    def write_review(self, app, src):
        d = Adw.AlertDialog(heading="Review %s" % app.name,
                            body="Your review is shared with everyone who uses GNOME Software or the Chamesle Store.")
        form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        picked = {"n": 0}
        row = Gtk.Box(spacing=2, halign=Gtk.Align.CENTER)
        btns = []

        def pick(b, n):
            picked["n"] = n
            for i, x in enumerate(btns):
                x.get_child().set_css_classes(["title-1", "stars" if i < n else "stars-off"])
            d.set_response_enabled("send", ready())
        for i in range(5):
            b = Gtk.Button(child=Gtk.Label(label="★", css_classes=["title-1", "stars-off"]), css_classes=["flat"])
            b.connect("clicked", pick, i + 1)
            btns.append(b)
            row.append(b)
        form.append(row)
        name = Gtk.Entry(placeholder_text="Your name (shown with the review)", text=GLib.get_real_name())
        summary = Gtk.Entry(placeholder_text="In a few words")
        text = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=6, bottom_margin=6, left_margin=6,
                            right_margin=6)
        form.append(name)
        form.append(summary)
        form.append(Gtk.Frame(child=Gtk.ScrolledWindow(child=text, min_content_height=120)))

        def ready(*a):
            b = text.get_buffer()
            return bool(picked["n"] and summary.get_text().strip() and
                        b.get_text(b.get_start_iter(), b.get_end_iter(), False).strip())
        summary.connect("changed", lambda *a: d.set_response_enabled("send", ready()))
        text.get_buffer().connect("changed", lambda *a: d.set_response_enabled("send", ready()))
        d.set_extra_child(form)
        d.add_response("cancel", "Cancel")
        d.add_response("send", "Send")
        d.set_response_appearance("send", Adw.ResponseAppearance.SUGGESTED)
        d.set_response_enabled("send", False)

        def answered(d, r):
            if r != "send":
                return
            b = text.get_buffer()
            body = {"app_id": src.ref, "locale": "en_US", "distro": "Chamesle", "version": src.version or "unknown",
                    "user_hash": user_hash(), "user_skey": getattr(self, "skeys", {}).get(src.ref, ""),
                    "user_display": name.get_text().strip() or "Someone", "rating": picked["n"] * 20,
                    "summary": summary.get_text().strip(),
                    "description": b.get_text(b.get_start_iter(), b.get_end_iter(), False).strip()}

            def send():
                try:
                    got = post(ODRS + "/submit", body)
                    ok = got.get("success", False)
                    msg = got.get("msg", "")
                except Exception as e:
                    ok, msg = False, str(e)
                GLib.idle_add(self.toast, "Thanks, your review is sent" if ok else "The review didn't go through: " + msg)
            threading.Thread(target=send, daemon=True).start()
        d.connect("response", answered)
        d.present(self.win)

    # ---- doing things

    def show_progress(self, text, frac):
        # frac None: no numbers yet, just keep the bar moving
        self.prog_label.set_label(text)
        if frac is None:
            self.prog.pulse()
        else:
            self.prog.set_fraction(max(0.0, min(1.0, frac)))
        self.prog_bar.set_reveal_child(True)

    def job(self, title, work, done_text, then=None):
        """run work(report) in a thread; report(text, fraction) moves the bar; work returns an error or None"""
        if self.busy:
            self.toast("One thing at a time, the last one is still going")
            return
        self.busy = True
        self.show_progress(title, 0.0)
        pulse = GLib.timeout_add(250, lambda: (self.prog.get_fraction() == 0 and self.prog.pulse(), True)[1])

        def report(text, frac):
            GLib.idle_add(self.show_progress, text, frac)

        def go():
            try:
                err = work(report)
            except Exception as e:
                err = str(e)
            GLib.idle_add(finish, err)

        def finish(err):
            self.busy = False
            GLib.source_remove(pulse)
            self.prog_bar.set_reveal_child(False)
            if not err:
                self.toast(done_text)
            elif err == "cancelled":
                self.toast("Cancelled")
            else:
                # the whole error, scrollable and copyable, and kept in a file to send to someone
                log = os.path.join(CACHE, "last-error.txt")
                os.makedirs(CACHE, exist_ok=True)
                with open(log, "w") as f:
                    f.write(title + "\n\n" + err + "\n")
                text = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                    top_margin=8, bottom_margin=8, left_margin=8, right_margin=8)
                text.get_buffer().set_text(err)
                box = Gtk.ScrolledWindow(child=text, min_content_height=220, min_content_width=480)
                d = Adw.AlertDialog(heading="That didn't work", body="The full error is also saved in " + log)
                d.set_extra_child(box)
                d.add_response("ok", "OK")
                d.present(self.win)
            self.catalog.load_installed()
            self.refresh_tab()
            if then:
                then()
            threading.Thread(target=self.check_updates, daemon=True).start()
        threading.Thread(target=go, daemon=True).start()

    def apk_job(self, args, title):
        # the helper runs apk with --progress-fd 1: lines like "1234/56789" (bytes done/total) on stdout
        def work(report):
            p = subprocess.Popen(["pkexec", HELPER] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            err = []
            t = threading.Thread(target=lambda: err.extend(p.stderr.readlines()), daemon=True)
            t.start()
            out, label = [], title
            for line in p.stdout:
                # "85973/14385942 install" is progress, "(2/9) Installing glibc (2.41-r1)" says what it's on
                m = re.match(r"(\d+)/(\d+)\b", line)
                step = re.match(r"\((\d+)/(\d+)\) \w+ (\S+)", line)
                if m and int(m.group(2)):
                    report(label, int(m.group(1)) / int(m.group(2)))
                elif step:
                    label = "%s · %s (%s of %s)" % (title, step.group(3), step.group(1), step.group(2))
                    out.append(line)
                else:
                    out.append(line)
            p.wait()
            t.join()
            if p.returncode in (126, 127):
                return "cancelled"
            return None if p.returncode == 0 else ("".join(err) or "".join(out)).strip()
        return work

    def flatpak_job(self, refs, title, remove=False, update=False):
        # through libflatpak, so there are real numbers to show
        def work(report):
            gi.require_version("Flatpak", "1.0")
            from gi.repository import Flatpak
            inst = Flatpak.Installation.new_system(None)
            t = Flatpak.Transaction.new_for_installation(inst, None)
            arch = Flatpak.get_default_arch()
            for ref in refs:
                full = ref if ref.startswith("app/") else "app/%s/%s/stable" % (ref, arch)
                if remove:
                    t.add_uninstall(full)
                elif update:
                    t.add_update(full, None, None)
                else:
                    t.add_install("flathub", full, None)
            state = {"n": 0}

            def new_op(t, op, progress):
                state["n"] += 1
                total = max(len(t.get_operations()), 1)
                name = op.get_ref().split("/")[1]
                progress.set_update_frequency(300)

                def changed(progress):
                    frac = (state["n"] - 1 + progress.get_progress() / 100) / total
                    report("%s (%d of %d: %s)" % (title, state["n"], total, name), frac)
                progress.connect("changed", changed)
                changed(progress)
            t.connect("new-operation", new_op)
            try:
                t.run(None)
            except GLib.Error as e:
                return "cancelled" if "cancel" in e.message.lower() else e.message
            return None
        return work

    def install_or_remove(self, app, src, then):
        inst = src in self.catalog.installed(app)
        title = "%s %s" % ("Removing" if inst else "Installing", app.name)
        if src.kind == "flathub":
            work = self.flatpak_job([src.ref], title, remove=inst)
        else:
            work = self.apk_job(["del" if inst else "add", src.ref], title)
        self.job(title, work, "%s %s" % (app.name, "removed" if inst else "installed"), then)

    def update_all(self):
        def work(report):
            err = self.apk_job(["upgrade"], "Updating the system")(report)
            if err:
                return err
            from gi.repository import Flatpak
            refs = [r.format_ref() for r in Flatpak.Installation.new_system(None).list_installed_refs_for_update(None)
                    if r.get_kind() == Flatpak.RefKind.APP]
            return self.flatpak_job(refs, "Updating apps", update=True)(report) if refs else None
        gi.require_version("Flatpak", "1.0")
        self.job("Updating everything", work, "Everything is up to date")

    def pick_file(self):
        f = Gtk.FileFilter(name=".deb and .rpm packages")
        for p in ("*.deb", "*.rpm"):
            f.add_pattern(p)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f)
        d = Gtk.FileDialog(title="Install a .deb or .rpm file", filters=filters)
        d.open(self.win, None, lambda d, res: self.picked(d, res))

    def picked(self, d, res):
        try:
            self.import_file(d.open_finish(res).get_path())
        except GLib.Error:
            pass

    def import_file(self, path):
        title = "Installing " + os.path.basename(path)
        self.job(title, self.apk_job(["import", path], title), "%s is installed" % os.path.basename(path))


if __name__ == "__main__":
    # --updates: open on the updates tab (the update notifier does that)
    updates = "--updates" in sys.argv
    sys.exit(Store(updates).run([a for a in sys.argv if a != "--updates"]))
