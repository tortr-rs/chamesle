#!/bin/sh
# double-clicked a windows program: run it with wine, installing and setting things up the first time
f=$1
# python looks it up: the gettext program isn't on every system, python is
_() { python3 -c 'import gettext, sys; gettext.textdomain("chamesle"); sys.stdout.write(gettext.gettext(sys.argv[1]))' "$1" 2>/dev/null || printf %s "$1"; }
title=$(_ "Windows program")
[ -n "$f" ] || { echo "usage: chamesle-exe FILE.exe" >&2; exit 1; }

# free space in MB where it all goes; the live session keeps everything in memory and runs out fast
room() { df -Pm "$1" | awk 'NR == 2 { print $4 }'; }
no_room() {
    if [ "$(id -un)" = live ]; then
        zenity --error --title="$title" --text="$(_ "Windows programs need about 3 GB of space, and this live session doesn't have that much memory to spare.\n\nInstall Chamesle first, then open the program again.")"
    else
        zenity --error --title="$title" --text="$(printf "$(_ "Windows programs need about %s GB of free space. Make some room and try again.")" "$1")"
    fi
    exit 1
}

if ! command -v wine >/dev/null; then
    [ "$(room /usr)" -ge 3200 ] || no_room 3
    zenity --question --title="$title" --icon=application-x-ms-dos-executable --ok-label="$(_ "Install")" --cancel-label="$(_ "Cancel")" \
        --text="$(printf "$(_ "To open %s, Chamesle needs Windows support (Wine).\n\nIt's a 650 MB download and takes about 3 GB on disk.\n\nInstall it now?")" "<b>$(basename "$f" | sed 's/&/\&amp;/g; s/</\&lt;/g')</b>")" || exit 0
    # the subshell keeps the pipe open, so the progress window stays up until apk is done
    (pkexec /usr/libexec/chamesle-store-helper add wine wine-mono wine-gecko dxvk >/dev/null 2>&1; echo 100) |
        zenity --progress --pulsate --auto-close --no-cancel --title="$title" --text="$(_ "Installing Windows support...")"
    if ! command -v wine >/dev/null; then
        zenity --error --title="$title" --text="$(_ "Windows support couldn't be installed. Check that you're online and try again.")"
        exit 1
    fi
fi

export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}" WINEDEBUG=-all

# dxvk needs a vulkan driver: intel, newer amd cards, or nvidia's own
vulkan() {
    for d in /sys/class/drm/card*/device/driver; do
        case $(basename "$(readlink "$d")") in i915|xe|amdgpu|nvidia) return 0 ;; esac
    done
    return 1
}

setup() {
    wineboot --init
    wineserver --wait
    if [ -d /usr/share/dxvk ] && vulkan; then
        sys="$WINEPREFIX/drive_c/windows"
        for dll in /usr/share/dxvk/x64/*.dll; do cp -f "$dll" "$sys/system32/"; done
        for dll in /usr/share/dxvk/x32/*.dll; do cp -f "$dll" "$sys/syswow64/"; done
        for name in d3d8 d3d9 d3d10core d3d11 dxgi; do
            wine reg add 'HKCU\Software\Wine\DllOverrides' /v "$name" /d native,builtin /f
        done
        wineserver --wait
    fi
}

if [ ! -f "$WINEPREFIX/system.reg" ]; then
    [ "$(room "$HOME")" -ge 1200 ] || no_room 1
    (setup >/dev/null 2>&1; echo 100) |
        zenity --progress --pulsate --auto-close --no-cancel --title="$title" \
            --text="$(_ "Setting up Windows support. This only happens once...")"
fi

cd "$(dirname "$f")" || exit 1
exec wine start /unix "$f"
