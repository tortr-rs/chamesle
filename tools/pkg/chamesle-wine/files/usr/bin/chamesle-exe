#!/bin/sh
# double-clicked a windows program: run it with wine, installing and setting things up the first time
f=$1
title="Windows program"
[ -n "$f" ] || { echo "usage: chamesle-exe FILE.exe" >&2; exit 1; }

if ! command -v wine >/dev/null; then
    zenity --question --title="$title" --icon=application-x-ms-dos-executable --ok-label=Install --cancel-label=Cancel \
        --text="To open <b>$(basename "$f" | sed 's/&/\&amp;/g; s/</\&lt;/g')</b>, Chamesle needs Windows support (Wine). It's about 400 MB.\n\nInstall it now?" || exit 0
    # the subshell keeps the pipe open, so the progress window stays up until apk is done
    (pkexec /usr/libexec/chamesle-store-helper add wine wine-mono wine-gecko dxvk >/dev/null 2>&1; echo 100) |
        zenity --progress --pulsate --auto-close --no-cancel --title="$title" --text="Installing Windows support..."
    if ! command -v wine >/dev/null; then
        zenity --error --title="$title" --text="Windows support couldn't be installed. Check that you're online and try again."
        exit 1
    fi
fi

export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}" WINEDEBUG=-all

# dxvk needs a vulkan driver: intel, newer amd cards, or nvidia's own
vulkan() {
    for d in /sys/class/drm/card*/device/driver; do
        case $(basename "$(readlink "$d")") in i915|xe|amdgpu|nvidia) return 0 ;; esac
    done
    return 1
}

setup() {
    wineboot --init
    wineserver --wait
    if [ -d /usr/share/dxvk ] && vulkan; then
        sys="$WINEPREFIX/drive_c/windows"
        for dll in /usr/share/dxvk/x64/*.dll; do cp -f "$dll" "$sys/system32/"; done
        for dll in /usr/share/dxvk/x32/*.dll; do cp -f "$dll" "$sys/syswow64/"; done
        for name in d3d8 d3d9 d3d10core d3d11 dxgi; do
            wine reg add 'HKCU\Software\Wine\DllOverrides' /v "$name" /d native,builtin /f
        done
        wineserver --wait
    fi
}

if [ ! -f "$WINEPREFIX/system.reg" ]; then
    (setup >/dev/null 2>&1; echo 100) |
        zenity --progress --pulsate --auto-close --no-cancel --title="$title" \
            --text="Setting up Windows support. This only happens once..."
fi

cd "$(dirname "$f")" || exit 1
exec wine start /unix "$f"
